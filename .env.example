# Local development environment.
# Copy this to .env and adjust as needed.
# For production (Render), these are set via render.yaml.

APP_ENV=development
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL=postgresql+asyncpg://shortener:shortener@db:5432/shortener
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

CACHE_TTL_SECONDS=3600
SHORT_URL_BASE=http://localhost:8000
