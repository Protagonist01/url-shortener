# Public development template. These placeholders are not deployment credentials.
# Generate unique values before use; do not commit the resulting .env.
APP_ENV=development
SECRET_KEY=replace_this_with_a_unique_local_secret
POSTGRES_USER=shortener
POSTGRES_PASSWORD=replace_this_local_db_password
POSTGRES_DB=shortener
DATABASE_URL=postgresql://shortener:replace_this_local_db_password@db:5432/shortener
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SHORT_URL_BASE=http://localhost:8000
CLICK_TRACKING_BACKEND=celery
# Existing timeout/cache/auth defaults remain in app/core/config.py.
# Launch quotas, pools, retention and performance targets require F01 decisions.
